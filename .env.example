# Copy to .env for local development. Never commit the real .env.
# All values below are placeholders, not working credentials.

# Required to launch audits. Without it POST /api/v1/audits answers 503 (fail closed).
AUDIT_ACCESS_CODE=change-me

# Attempts per client per minute on the audit launch endpoint.
AUDIT_RATE_LIMIT_PER_MINUTE=10

# Offline mode only: set to 0 to start without the fictional demo audit.
# Database mode never seeds or publishes an audit at startup.
SEED_DEMO_AUDIT=1

# Set DATABASE_URL to use the existing Azure SQL ci schema. With no URL,
# only the process-local offline fixture demonstration is available.
# DATABASE_URL=mssql+mssqlpython://USER:URLENCODED_PASSWORD@SERVER.database.windows.net:1433/DB?encrypt=yes
# Separate, disposable Azure SQL database with the same manually provisioned schema.
# TEST_DATABASE_URL=

# Separate worker settings (seconds). Retries are bounded; expired final leases fail.
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=10

# Reserved for Phase 4 live agents; the fixture worker does not use this key.
# LLM_API_KEY=
