# Copy to .env for local development. Never commit the real .env.
# All values below are placeholders, not working credentials.

# Required to launch audits. Without it POST /api/v1/audits answers 503 (fail closed).
AUDIT_ACCESS_CODE=change-me

# Production and Vercel preview require durable storage, an access code of at
# least 16 characters, and explicit comma-separated hosts. Never use change-me.
APP_ENV=development
# TRUSTED_HOSTS=your-app.vercel.app,your-domain.example
MAX_CONTENT_LENGTH=16384

# Shared rolling quotas (all suppliers/modes/clients combined). Azure admission
# uses a transaction-owned application lock; no additional database table.
AUDIT_LAUNCHES_PER_MINUTE=5
AUDIT_LAUNCHES_PER_DAY=30
AUDIT_MAX_PENDING=10

# Best-effort per-process attempts per client; deploy an edge limit as well.
AUDIT_RATE_LIMIT_PER_MINUTE=10

# Offline mode only: set to 0 to start without the fictional demo audit.
# Database mode never seeds or publishes an audit at startup.
SEED_DEMO_AUDIT=1

# Set DATABASE_URL to use the existing Azure SQL ci schema. With no URL,
# the demonstration runs inline with process-local audit state.
# DATABASE_URL=mssql+mssqlpython://USER:URLENCODED_PASSWORD@SERVER.database.windows.net:1433/DB?encrypt=yes
# Separate, disposable Azure SQL database with the same manually provisioned schema.
# TEST_DATABASE_URL=

# Separate worker settings (seconds). Retries are bounded; expired final leases fail.
WORKER_LEASE_SECONDS=60
WORKER_MAX_ATTEMPTS=3
WORKER_RETRY_SECONDS=10

# Confirmed ci.source_captures success value. Defaults to ok; optional to set.
# blocked/error are never successful captures, and other settings are rejected.
SOURCE_CAPTURE_SUCCESS_STATUS=ok

# Optional Phase 4 model adapter. A key alone never enables requests.
# Project provider/model. Supported adapters: gemini (native API), openai (Responses API).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
# LLM_API_KEY=
LLM_MAX_REQUESTS=32
LLM_MAX_INPUT_CHARS=240000
LLM_MAX_OUTPUT_TOKENS=2000
LLM_MAX_CLAIMS=20
LLM_TIMEOUT_SECONDS=30

# Read-only, manually reviewed reference bundle with original source hashes and validity dates.
# REFERENCE_BUNDLE_PATH=
