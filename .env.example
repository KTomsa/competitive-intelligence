# Zkopírujte jako .env (soubor .env se necommituje).

# Jazykový model je volitelný. Bez něj aplikace běží: nová tvrzení hledá podle klíčových slov
# a briefing skládá ze šablony. Čísla a verdikty počítá vždy kód.
CI_USE_LLM=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Volitelný sdílený kód, který chrání spuštění auditu na veřejně dostupném nasazení.
DEMO_CODE=
