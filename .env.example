# Copy to .env for local development. Never commit the real .env.
# All values below are placeholders, not working credentials.

# Required to launch audits. Without it POST /api/v1/audits answers 503 (fail closed).
AUDIT_ACCESS_CODE=change-me

# Attempts per client per minute on the audit launch endpoint.
AUDIT_RATE_LIMIT_PER_MINUTE=10

# Set to 0 to start without the fictional demo audit on the home page.
SEED_DEMO_AUDIT=1

